DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
DB_ECHO=false

# LLM Configuration (provider-agnostic via init_chat_model)
# Providers: openai, anthropic, google_genai, ollama, etc.
LLM_MODEL=gpt-5-mini
LLM_PROVIDER=openai
LLM_TEMPERATURE=0
# LLM_BASE_URL=http://localhost:11434/v1  # For Ollama or local models
# OPENAI_API_KEY=sk-...

# PPIP / e-GP (Kenya procurement data sources)
PPIP_BASE_URL=https://tenders.go.ke/api/ocds
PPIP_TIMEOUT=30.0

# Redis (for async recomputation jobs)
REDIS_URL=redis://localhost:6379
